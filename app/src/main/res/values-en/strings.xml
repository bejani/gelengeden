    <!-- About / Help -->
    <string name="about_title">About &amp; Help</string>
    <string name="about_cd">About and help</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_what_title">What is Gelengeden?</string>
    <string name="about_what_body">Gelengeden is a personal ledger for income (gelen) and expenses (giden). Track balance, categories, reports, and backups in one place — all data stays on your device.</string>
    <string name="about_help_title">Quick help</string>
    <string name="about_help_transactions_title">Transactions</string>
    <string name="about_help_transactions_body">Tap + to add income or expense. Tap a row to edit it, or use delete to remove it. Search by name and filter with All / Income / Expense. Use the export icon next to Transactions to save the current list as CSV or Excel.</string>
    <string name="about_help_categories_title">Categories</string>
    <string name="about_help_categories_body">Open Categories from the home toolbar to add, rename, or delete income and expense categories. You pick them when saving a transaction.</string>
    <string name="about_help_reports_title">Reports</string>
    <string name="about_help_reports_body">The chart icon opens period summaries, insights (savings rate, daily averages, and more), and monthly or category charts. Choose a preset period or a custom range.</string>
    <string name="about_help_backup_title">Backup &amp; restore</string>
    <string name="about_help_backup_body">Use the backup icon to export or restore all transactions and categories as a JSON file. Restore fully replaces current data — make a fresh backup first.</string>
    <string name="about_help_widget_title">Home screen widget</string>
    <string name="about_help_widget_body">Add the balance widget to your phone home screen to see balance, income, and expense without opening the app.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">No cloud account or server is required. Your data is stored only in a local database on this device. The app password is used only on this device to lock access.</string>
    <string name="about_help_settings_title">Settings &amp; password</string>
    <string name="about_help_settings_body">Use the settings icon to change your password or lock the app so a password is required again.</string>
    <string name="about_footer">Built for simple income and expense tracking — Gelengeden</string>
